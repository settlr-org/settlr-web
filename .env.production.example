# Production — dedicated server (https://example.com)
# Vercel project settlr (production env)
API_URL=https://api.example.com
NEXT_PUBLIC_API_URL=https://api.example.com
# Google OAuth Web application client ID. This is public by design; the API
# allow-lists this value in GOOGLE_OAUTH_CLIENT_IDS before accepting tokens.
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=replace-with-google-web-client-id.apps.googleusercontent.com
